# Whisper modeli: tiny | base | small | medium | large-v3
# Kichik model = tezroq, katta model = aniqroq (Uzbek tili uchun small tavsiya etiladi)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# Ma'lumotlar papkasi (joblar + audio)
DATA_DIR=data

# Yuklash cheklovi
MAX_UPLOAD_MB=100

# Eski joblarni tozalash (soat)
JOB_TTL_HOURS=48

# --- YouTube 403 xatosini hal qilish (ixtiyoriy) ---
# 1) Netscape formatdagi cookies.txt fayli yo'li (brauzerda
#    'Get cookies.txt LOCALLY' kengaytmasi bilan olinadi):
# YT_COOKIES_FILE=/path/to/cookies.txt
# 2) Yoki brauzerdan to'g'ridan-to'g'ri cookies olish (lokal rejimda):
# YT_BROWSER=chrome   # chrome | firefox | safari | edge | brave | ...
