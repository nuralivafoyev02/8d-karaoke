[TEMPLATE]
# Whisper modeli: tiny | base | small | medium | large-v3
# Kichik model = tezroq, katta model = aniqroq (Uzbek tili uchun small tavsiya etiladi)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# Ma'lumotlar papkasi (joblar + audio)
DATA_DIR=data

# Yuklash cheklovi
MAX_UPLOAD_MB=100

# Eski joblarni tozalash (soat)
JOB_TTL_HOURS=48

# --- YouTube bot-blokirovkasini hal qilish (ixtiyoriy) ---
# YouTube server IP'larini (masalan Render) bot deb bloklashi mumkin.
# Yechim: brauzerdan cookies.txt oling va shu yerga qo'ying.
#
# 'Get cookies.txt LOCALLY' (Chrome/Firefox kengaytmasi) bilan olingan
# Netscape formatdagi cookies.txt faylining KONTENTINI shu yerga qo'ying:
# YT_COOKIES=# Netscape HTTP Cookie File\n...\n.youtube.com\tTRUE\t/\tTRUE\t...\n
#
# Yoki fayl yo'li (agar fayl serverda mavjud bo'lsa):
# YT_COOKIES_FILE=/path/to/cookies.txt
#
# Lokal rejimda brauzerdan to'g'ridan-to'g'ri o'qish ham mumkin:
# YT_BROWSER=chrome   # chrome | firefox | safari | edge | brave | ...
